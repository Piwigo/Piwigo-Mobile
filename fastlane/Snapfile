# piwigoScreenshots #
#####################
# Installation:
#	cd '/Users/lelievre/Privé - GitHub/Piwigo-Mobile'
#
# Set up a complete Ruby web development environment
# brew install openssl@3 libyaml readline ruby-install chruby
# ruby-install ruby 3.4.10
# sed -i '' 's/^chruby ruby-3.4.0$/chruby ruby-3.4.10/' ~/.zshrc
#
# Then in a new shell, from the repo:
#	gem install bundler -v 4.0.20 && bundle install && bundle exec fastlane --version
#
# Clean or update:
#   gem cleanup (from time to time to speed up fastlane)
#   gem update
#   bundle install
#	bundle update --bundler
#	fastlane init
#   fastlane init swift
#   fastlane snapshot update
#	bundle update fastlane
#   bundle exec fastlane snapshot update
#	
# To locate fastlane
#	which fastlane
#
# To get a list of available options
#   bundle exec fastlane action deliver
# To download App Store Connect existing metadata
#   bundle exec fastlane deliver download_metadata
# To download App Store Connect existing screenshots
#   bundle exec fastlane deliver download_screenshots
# To upload screenshots only
#   bundle exec fastlane deliver --force --skip_binary_upload --skip_app_version_update --skip_metadata --overwrite_screenshots
# To upload metadata only
#   bundle exec fastlane deliver --force --skip_binary_upload --skip_app_version_update --skip_screenshots
# To upload screenshots and metadata
#   bundle exec fastlane deliver --force --skip_binary_upload --skip_app_version_update --overwrite_screenshots
#
# To produce snapshots:
#	bundle exec fastlane snapshot
#
# To get even more debug information:
#   add "--verbose" at the end of the command line
#
# A list of devices you want to take the screenshots from
# https://developer.apple.com/help/app-store-connect/reference/screenshot-specifications
devices([
"iPhone Duo",
#"iPhone Air",								# iPhone with Dynamic Island (large display)
#"iPhone 14 Plus",							# iPhone with Face ID (large display)
#"iPhone 17 Pro",							# iPhone with Dynamic Island (medium display)
#"iPhone 17e",								# iPhone with Face ID (medium display)
#"iPhone 8 Plus",							# iPhone with Home Button (large display)
#"iPhone SE (3rd generation)",				# iPhone with Home Button (medium display)
#"iPhone SE (1st generation)",				# iPhone with Home Button (4" display)
#"iPad Pro 13-inch (M5)"						# 13" display
#"iPad Pro (12.9-inch) (2nd generation)",	# 12.9" display
#"iPad Pro 11-inch (M5)",					# 11" display
#"iPad Pro (10.5-inch)",						# 10.5" display
#"iPad Pro (9.7-inch)",						# 9.7" display
])

# List of languages
languages([
"en-US",
"zh-Hans",
"zh-Hant",
"cs",
"da",
"nl-NL",
"fr-FR",
"de-DE",
"hu",
"it",
"id",
"ja",
"pl",
"pt-BR",
"pt-PT",
"ru",
"es-ES",
"sv",
"uk",
"ar-SA"
])

# Parameters
project("piwigo.xcodeproj")
scheme("Screenshots")
derived_data_path("DerivedData/piwigo")
test_without_building(true)   # must be false once before launching all languages
output_directory("fastlane/screenshots")
concurrent_simulators(true)
localize_simulator(true)      # sets the simulator system language (e.g. localized date in iPad status bar)
skip_open_summary(true)
number_of_retries(1)
clear_previous_screenshots(false)

