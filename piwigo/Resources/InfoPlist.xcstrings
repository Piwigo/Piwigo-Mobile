    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم معرف الوجه بدلاً من رمز المرور للوصول إلى الألبومات الخاصة بك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použijte Face ID místo kódu pro přístup ke svým albům."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug Ansigts-ID i stedet for en adgangskode for at få adgang til dine albummer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie Face ID anstelle eines Passworts um auf Ihre Alben zuzugreifen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use Face ID instead of a passcode to access your albums."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilice Face ID en lugar de un código de acceso para acceder a sus álbumes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Face ID au lieu d'un mot de passe pour accéder à vos albums."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Használja a Face ID-t jelszó helyett az albumok eléréséhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan ID Wajah alih-alih kode sandi untuk mengakses album Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Face ID invece di un codice di accesso per accedere ai tuoi album."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスコードの代わりに Face ID を使用してアルバムにアクセスします。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik Face ID in plaats van een toegangscode om toegang te krijgen tot je albums."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj Face ID zamiast hasła, aby uzyskać dostęp do swoich albumów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o Face ID em vez de um código para acessar seus álbuns."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilize o Face ID em vez de um código para aceder aos seus álbuns."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте Face ID вместо секретного кода для доступа к альбомам."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd Face ID istället för en lösenkod för att komma åt dina album."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте Face ID замість коду для доступу до ваших альбомів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用Face ID代替密码访问您的相册。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Face ID 代替密碼存取相簿。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Piwigo الشبكة المحلية للوصول إلى خادم Piwigo الخاص بك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo používá místní síť pro přístup k vašemu serveru Piwigo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo bruger det lokale netværk til at tilgå din Piwigo-server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo verwendet das lokale Netzwerk, um auf Ihren Piwigo-Server zuzugreifen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Piwigo uses the local network to access your Piwigo server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo utiliza la red local para acceder al servidor Piwigo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo utilise le réseau local pour accéder à votre serveur Piwigo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Piwigo a helyi hálózatot használja a Piwigo szerver eléréséhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo menggunakan jaringan lokal untuk mengakses server Piwigo Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo utilizza la rete locale per accedere al tuo server Piwigo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigoは、ローカルネットワークを使用してPiwigoサーバーにアクセスします。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo gebruikt het lokale netwerk voor toegang tot je Piwigo-server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo używa sieci lokalnej, aby uzyskać dostęp do Twojego serwera Piwigo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Piwigo usa a rede local para acessar o seu servidor Piwigo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Piwigo utiliza a rede local para aceder ao seu servidor Piwigo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo использует локальную сеть для доступа к вашему серверу Piwigo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo använder det lokala nätverket för att komma åt din Piwigo-server."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo використовує локальну мережу для доступу до вашого сервера Piwigo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo 使用本地网络访问 Piwigo 服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo 使用本機網路存取您的 Piwigo 伺服器。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Piwigo uses your location to start the map where you are when you add the location of a photo.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Piwigo موقعك لبدء الخريطة من مكانك عند إضافة موقع صورة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo používá vaši polohu, aby se mapa při přidávání polohy fotografie otevřela tam, kde se nacházíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo bruger din placering til at starte kortet, hvor du er, når du tilføjer et fotos placering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo verwendet Ihren Standort, um die Karte beim Hinzufügen eines Fotoorts an Ihrer Position zu starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo uses your location to start the map where you are when you add the location of a photo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo usa tu ubicación para iniciar el mapa donde estás al añadir la ubicación de una foto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo utilise votre position pour ouvrir la carte là où vous êtes lorsque vous ajoutez la position d'une photo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Piwigo a tartózkodási helyedet használja, hogy a térkép ott nyíljon meg, ahol vagy, amikor egy fénykép helyét hozzáadod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo menggunakan lokasi Anda untuk membuka peta di tempat Anda berada saat menambahkan lokasi foto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo usa la tua posizione per aprire la mappa dove ti trovi quando aggiungi la posizione di una foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真の位置情報を追加するとき、現在地を中心に地図を開くために位置情報を使用します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo gebruikt je locatie om de kaart te openen waar je bent wanneer je de locatie van een foto toevoegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo używa Twojej lokalizacji, aby ustawić mapę tam, gdzie jesteś, podczas dodawania lokalizacji zdjęcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Piwigo usa sua localização para abrir o mapa onde você está ao adicionar a localização de uma foto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Piwigo usa a sua localização para abrir o mapa onde se encontra ao adicionar a localização de uma foto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo использует ваше местоположение, чтобы открыть карту там, где вы находитесь, когда вы добавляете местоположение фото."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo använder din plats för att öppna kartan där du är när du lägger till ett fotos plats."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piwigo використовує ваше місцезнаходження, щоб відкрити карту там, де ви перебуваєте, коли додаєте місцезнаходження фото."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加照片位置时，Piwigo 会使用你的位置将地图定位到你所在之处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增照片位置時，Piwigo 會使用你的位置將地圖定位到你所在之處。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "InfoPlist.strings\n  piwigo\n\n  Created by Eddy Lelièvre-Berna on 13/08/2017.\n  Copyright © 2017 Piwigo.org. All rights reserved.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بحيث أنها سوف تكون قادرة على تحميل الصور إلى الصور وتحميل الصور إلى Piwigo الخاص بك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "aby mohla ukládat fotky do aplikace Fotky a nahrávat fotky do vašeho Piwigo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "så den vil have mulighed for at gemme billeder i kamerarulle og uploade billeder til din Piwigo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ermöglicht, Fotos auf herunterzuladen und Fotos auf Ihren Piwigo-Server hochzuladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "so that it will be able to store photos in the Photos app and upload photos to your Piwigo."
          }
        },
        "es" : {
